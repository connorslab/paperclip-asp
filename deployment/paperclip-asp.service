[Unit]
Description=Paperclip XBT Ark service provider
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=paperclip-asp
Group=paperclip-asp
WorkingDirectory=/opt/paperclip-asp
EnvironmentFile=/etc/paperclip-asp/environment
ExecStart=/opt/paperclip-asp/deployment/run-asp.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/paperclip-asp
RestrictSUIDSGID=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
